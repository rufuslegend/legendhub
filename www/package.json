{
    "name": "legendhub",
    "version": "3.1.0-beta",
    "description": "A resource hub for LegendMUD",
    "scripts": {
        "build:client": "vite build",
        "audit:ui-parity": "node scripts/audit-ui-parity.js",
        "parity:visual": "node scripts/audit-visual-parity.js",
        "dev:client": "vite build --watch",
        "pretest": "npm run build:client",
        "test": "node --test",
        "test:characterization": "node --test test/characterization.test.js",
        "test:migrations:integration": "MYSQL_MIGRATION_INTEGRATION=1 node --test test/migrations.integration.test.js",
        "test:smoke": "node --test test/smoke.test.js",
        "pretest:a11y": "npm run build:client",
        "test:a11y": "playwright test",
        "start": "node src/app.js"
    },
    "engines": {
        "node": ">=22.12"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rufuslegend/legendhub.git"
    },
    "keywords": [
        "legendhub",
        "legendmud",
        "hub",
        "mud"
    ],
    "author": {
        "name": "Steve Thorne",
        "url": "https://www.sthorne.dev"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rufuslegend/legendhub/issues"
    },
    "homepage": "https://github.com/rufuslegend/legendhub#readme",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "graphql": "^16.14.2",
        "graphql-http": "^1.22.4",
        "graphql-scalars": "^1.25.0",
        "helmet": "^8.3.0",
        "markdown-it": "^15.0.0",
        "markdown-it-emoji": "^3.1.0",
        "morgan": "^1.11.0",
        "mysql": "^2.18.1",
        "nodemailer": "^7.0.13",
        "ruru": "^2.0.1",
        "sync-rpc": "^1.3.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.62.1",
        "@vitejs/plugin-react": "^6.1.0",
        "bootstrap": "4.3.1",
        "dompurify": "3.4.14",
        "jquery": "3.7.1",
        "pixelmatch": "7.2.0",
        "pngjs": "7.0.0",
        "popper.js": "1.14.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "vite": "^8.2.2"
    }
}
