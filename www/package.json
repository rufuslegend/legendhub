{
    "name": "legendhub",
    "version": "2.6.0",
    "description": "A resource hub for LegendMUD",
    "scripts": {
        "test": "node --test",
        "test:characterization": "node --test test/characterization.test.js",
        "test:migrations:integration": "MYSQL_MIGRATION_INTEGRATION=1 node --test test/migrations.integration.test.js",
        "test:smoke": "node --test test/smoke.test.js",
        "start": "node src/app.js"
    },
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rufuslegend/legendhub.git"
    },
    "keywords": [
        "legendhub",
        "legendmud",
        "hub",
        "mud"
    ],
    "author": {
        "name": "Steve Thorne",
        "url": "https://www.sthorne.dev"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rufuslegend/legendhub/issues"
    },
    "homepage": "https://github.com/rufuslegend/legendhub#readme",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "graphql": "^16.14.2",
        "graphql-http": "^1.22.4",
        "graphql-scalars": "^1.25.0",
        "helmet": "^8.3.0",
        "markdown-it": "^15.0.0",
        "morgan": "^1.11.0",
        "mysql": "^2.18.1",
        "ruru": "^2.0.1",
        "sync-rpc": "^1.3.7"
    }
}
