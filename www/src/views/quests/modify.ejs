<!doctype html>
<html lang="en">
    <head>
        <%-include("../shared/meta");-%>
        <%if (vm.quest.id) {%>
        <link href="https://www.legendhub.org/quests/edit.html?id=<%-vm.quest.id%>" rel="canonical">
        <%}else{%>
        <link href="https://www.legendhub.org/quests/add.html" rel="canonical">
        <%}%>
        <meta name="robots" content="none">
    </head>
    <body>
        <%-include("../shared/header");-%>
        <div data-react-root="quest-editor"></div>
        <script type="application/json" data-react-props="quest-editor"><%-
            serializeJsonForHtml({quest: vm.quest, areas: vm.areas})
        %></script>
        <%-include("../shared/footer");-%>
        <%-include("../shared/scripts");-%>
        <script type="module" src="/build/quest-editor.js?v=<%-locals.version%>"></script>
    </body>
</html>
