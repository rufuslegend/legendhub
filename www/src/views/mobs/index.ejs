<!doctype html>
<html lang="en">
<head>
    <%-include("../shared/meta")-%>
    <link href="https://www.legendhub.org<%=vm.urls.canonical%>" rel="canonical">
</head>
<body>
    <%-include("../shared/header")-%>
    
	<div class="container-fluid">
		<div class="px-0">
			<div class="row">
                <div id="mobs-categories" class="categoryListBackground" data-category-list>
                    <nav class="categoryListContainer" aria-label="Mob areas">
                        <button class="categoryListClose" type="button" data-category-list-close aria-label="Close areas"><i class="fas fa-times" aria-hidden="true"></i></button>
                        <h2>Areas</h2>
                        <ul class="categoryList">
                            <%for (let i = 0; i < vm.categories.length; ++i) {%>
                            <li> 
                                <a<%-(vm.categoryId == vm.categories[i].id && !vm.subcategoryId) ? ' class="active"' : ''%> href="<%=vm.urls.category(vm.categories[i].id)%>"><%=vm.categories[i].name%></a>
                                <%if(vm.categoryId == vm.categories[i].id) {%>
                                <ul>
                                    <%for (let j = 0; j < vm.categories[i].subcategories.length; ++j) {%>
                                    <li>
                                        <a<%-(vm.subcategoryId == vm.categories[i].subcategories[j].id) ? ' class="active"':''%> href="<%=vm.urls.category(vm.categories[i].id, vm.categories[i].subcategories[j].id)%>"><%=vm.categories[i].subcategories[j].name%></a>
                                    </li>
                                    <%}%>
                                </ul>
                                <%}%>
                            </li>
                            <%}%>
                        </ul>
                    </nav>
                </div>
				<div class="col">
					<div class="row text-center">
						<h1 class="col-12">Mobs</h1>
					</div>
					<div class="px-0 px-md-5">
                        <form action="<%=vm.urls.form%>">
                            <%if (vm.categoryId) {%>
                            <input type="hidden" name="eraId" value="<%=vm.categoryId%>">
                            <%}%>
                            <%if (vm.subcategoryId) {%>
                            <input type="hidden" name="areaId" value="<%=vm.subcategoryId%>">
                            <%}%>
							<div class="row">
								<div class="input-group col-12">
									<div class="input-group-prepend d-block d-md-none">
                                        <button class="btn btn-outline-primary" type="button" data-category-list-open aria-controls="mobs-categories" aria-expanded="false" aria-label="Open areas">&nbsp;<i class="fas fa-caret-right" aria-hidden="true"></i>&nbsp;
									</div>
                                    <%if (vm.activeCategory) {%>
                                    <div class="input-group-prepend">
                                        <a class="btn btn-outline-primary" role="button" href="<%=vm.urls.search%>"><%=vm.activeCategory%>&nbsp;&nbsp;<i class="fas fa-times"></i></a>
                                    </div>
                                    <%}%>
                                    <input type="text" name="search" value="<%=vm.searchString ?? ""%>" class="form-control" placeholder="Search by name..." autofocus>
									<div class="input-group-append">
										<button class="btn btn-primary" type="submit"><span class="d-none d-md-inline-block">Search</span><i class="d-inline-block d-md-none fas fa-search"></i></button>
									</div>
								</div>
							</div>
						</form>
					</div>
					<br />
                    <%-include("../shared/pagination", {pageUrl: vm.urls.page, page: vm.page, rows: vm.rows, resultLength: vm.results.length, moreResults: vm.moreResults})-%>
                    
					<div class="row">
						<div class="col-12">
							<div class="card">
								<div class="card-header">
                                    <strong class="float-left"><%-(vm.noSearch ? "Recently Modified":"Search Results")%></strong>
                                    <%if(locals.user){%>
                                    <div class="float-right">
                                        <a href="/mobs/add.html" aria-label="Add mob">
                                            <i class="fas fa-plus" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                    <%}else{%>
                                    <div class="float-right">
                                        <a href="/login.html?returnUrl=/mobs/add.html" aria-label="Add mob">
                                            <i class="fas fa-plus" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                    <%}%>
								</div>
								<div class="table-responsive">
									<table class="table table-sm table-md table-hover table-striped table-bordered mb-0">
										<thead class="thead-dark">
											<tr>
                                                <% let sortClass = function(sortBy) {
                 if (vm.query.sortBy === sortBy)
                 return vm.query.sortAsc ? "fas fa-sort-up" : "fas fa-sort-down";
                 else if (!vm.query.sortBy)
                 return "fas fa-sort";
                 else
                 return "";
                 };%>
                 <th scope="col" class="text-center" nowrap><a class="text-reset" href="<%=vm.urls.sort("name", vm.query.sortBy === "name" ? !vm.query.sortAsc : true)%>">Name&nbsp;<i class="<%=sortClass('name')%>" aria-hidden="true"></i></a></th>
												<th scope="col" class="text-center" nowrap><a class="text-reset" href="<%=vm.urls.sort("areaName", vm.query.sortBy === "areaName" ? !vm.query.sortAsc : true)%>">Area&nbsp;<i class="<%=sortClass('areaName')%>" aria-hidden="true"></i></a></th>
												<th scope="col" class="text-center" nowrap><a class="text-reset" href="<%=vm.urls.sort("xp", vm.query.sortBy === "xp" ? !vm.query.sortAsc : false)%>">Experience&nbsp;<i class="<%=sortClass('xp')%>" aria-hidden="true"></i></a></th>
												<th scope="col" class="text-center" nowrap><a class="text-reset" href="<%=vm.urls.sort("gold", vm.query.sortBy === "gold" ? !vm.query.sortAsc : false)%>">Gold&nbsp;<i class="<%=sortClass('gold')%>" aria-hidden="true"></i></a></th>
												<th scope="col" class="text-center" nowrap><a class="text-reset" href="<%=vm.urls.sort("aggro", vm.query.sortBy === "aggro" ? !vm.query.sortAsc : false)%>">Agg&nbsp;<i class="<%=sortClass('aggro')%>" aria-hidden="true"></i></a></th>
											</tr>
										</thead>
										<tbody>
                                            <%for (let i = 0; i < vm.results.length; ++i) {%>
                                            <tr>
                                                <th scope="row"><a class="text-primary" href="/mobs/details.html?id=<%-vm.results[i].id%>"><%=vm.results[i].name%></a><a class="float-right" href="/mobs/details.html?id=<%-vm.results[i].id%>" target="_blank" rel="noopener" aria-label="Open details for <%=vm.results[i].name%> in a new tab"><i class="fas fa-external-link-alt fa-lg" aria-hidden="true"></i></a></th>
                                                <td><%if(vm.results[i].eraName){%><span class="text-info">(<%=vm.results[i].eraName%>)</span> <%}%><%=vm.results[i].areaName%></td>
                                                <td class="text-center"><%=vm.results[i].xp%></td>
                                                <td class="text-center"><%=vm.results[i].gold%></td>
                                                <td class="text-center">
                                                    <%_ if (vm.results[i].aggro) {_%>
                                                    <i class="text-success fas fa-check"></i>
                                                    <%_} else {_%>
                                                    <i class="text-danger fas fa-times"></i>
                                                    <%_}_%>
                                                </td>
                                            </tr>
                                            <%}%>
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
                    <br>
                    <%-include("../shared/pagination", {pageUrl: vm.urls.page, page: vm.page, rows: vm.rows, resultLength: vm.results.length, moreResults: vm.moreResults})-%>
                        <br><br>
				</div>
			</div>
		</div>
	</div>
    <%-include("../shared/footer")-%>
    <%-include("../shared/scripts")-%>
</body>
</html>
