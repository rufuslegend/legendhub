<!doctype html>
<html lang="en">
    <head>
        <%-include("../shared/meta")-%>
        <link href="https://www.legendhub.org/account/index.html" rel="canonical">
        <meta name="robots" content="none">
    </head>
    <body>
        <%-include("../shared/header")-%>
        <div data-react-root="account-settings"></div>
        <script type="application/json" data-react-props="account-settings"><%-
            serializeJsonForHtml({
                notificationSettings: vm.notificationSettings,
                emailStatus: vm.emailStatus,
                builderStorage: vm.builderStorage
            })
        %></script>
        <%-include("../shared/footer")-%>
        <%-include("../shared/scripts")-%>
        <script type="module" src="/build/account.js?v=<%-locals.version%>"></script>
    </body>
</html>
