<!doctype html>
<% this.title = `${status} Error`; %>
<html lang="en">
    <head>
        <%-include("../shared/meta");-%>
        <meta name="robots" content="none">
    </head>
    <body>
        <div class="container">
            <br><br>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header text-center">
                            <h1><%=status >= 500 ? "Server Error" : "Request Error"%></h1>
                        </div>
                        <div class="card-body text-center">
                            <p><%=message%></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%-include("../shared/scripts");-%>
    </body>
</html>
