<!doctype html>
<html lang="en">
    <head>
        <%-include("../shared/meta")-%>
        <link href="https://www.legendhub.org<%=vm.urls.canonical%>" rel="canonical">
        <meta name="robots" content="noindex">
    </head>
    <body>
        <%-include("../shared/header")-%>
        <div class="container-fluid">
            <div class="px-0">
                <div class="row">
                    <div id="wiki-categories" class="categoryListBackground" data-category-list>
                      <nav class="categoryListContainer" aria-label="Wiki categories">
                        <button class="categoryListClose" type="button" data-category-list-close aria-label="Close categories"><i class="fas fa-times" aria-hidden="true"></i></button>
                        <h2>Categories</h2>
                        <ul class="categoryList">
                            <%for (let i = 0; i < vm.categories.length; ++i) {%>
                            <li> 
                                <a<%-(vm.categoryId == vm.categories[i].id && !vm.subcategoryId) ? ' class="active"' : ''%> href="<%=vm.urls.category(vm.categories[i].id)%>"><%=vm.categories[i].name%></a>
                                <%if(vm.categoryId == vm.categories[i].id) {%>
                                <ul>
                                    <%for (let j = 0; j < vm.categories[i].subcategories.length; ++j) {%>
                                    <li>
                                        <a<%-(vm.subcategoryId == vm.categories[i].subcategories[j].id) ? ' class="active"':''%> href="<%=vm.urls.category(vm.categories[i].id, vm.categories[i].subcategories[j].id)%>"><%=vm.categories[i].subcategories[j].name%></a>
                                    </li>
                                    <%}%>
                                </ul>
                                <%}%>
                            </li>
                            <%}%>
                        </ul>
                      </nav>
                    </div>
                    <div class="col">
                        <div class="row text-center">
                            <h1 class="col-12">Wiki</h1>
                        </div>
                        <div class="px-0 px-md-5">
                            <form action="<%=vm.urls.form%>">
                                <%if (vm.categoryId) {%>
                                <input type="hidden" name="categoryId" value="<%=vm.categoryId%>">
                                <%}%>
                                <%if (vm.subcategoryId) {%>
                                <input type="hidden" name="subcategoryId" value="<%=vm.subcategoryId%>">
                                <%}%>
                                <div class="row">
                                    <div class="input-group col-12">
                                        <div class="input-group-prepend d-block d-md-none">
                                            <button class="btn btn-outline-primary" type="button" data-category-list-open aria-controls="wiki-categories" aria-expanded="false" aria-label="Open categories">&nbsp;<i class="fas fa-caret-right" aria-hidden="true"></i>&nbsp;
                                        </div>
                                        <%if (vm.activeCategory) {%>
                                        <div class="input-group-prepend">
                                            <a class="btn btn-outline-primary" role="button" href="<%=vm.urls.search%>"><%=vm.activeCategory%>&nbsp;&nbsp;<i class="fas fa-times"></i></a>
                                        </div>
                                        <%}%>
                                        <input type="text" name="search" value="<%=vm.query.search ?? ""%>" class="form-control" placeholder="Search by title, tags, or content..." autofocus>
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="submit"><span class="d-none d-md-inline-block">Search</span><i class="d-inline-block d-md-none fas fa-search"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <br />
                        <%-include("../shared/pagination", {pageUrl: vm.urls.page, page: vm.page, rows: vm.rows, resultLength: vm.results.length, moreResults: vm.moreResults})-%>
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <strong class="float-left"><%-(vm.noSearch ? "Recently Modified":"Search Results")%></strong>
                                        <div class="float-right">
                                            <a href="<%-(locals.user ? "":"/login.html?returnUrl=")%>/wiki/add.html" aria-label="Add wiki page">
                                                <i class="fas fa-plus" aria-hidden="true"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-md table-hover table-striped table-bordered mb-0">
                                            <thead class="thead-dark">
                                                <tr>
                                                    <% let sortClass = function(sortBy) {
                 if (vm.query.sortBy === sortBy)
                 return vm.query.sortAsc ? "fas fa-sort-up" : "fas fa-sort-down";
                 else if (!vm.query.sortBy)
                 return "fas fa-sort";
                 else
                 return "";
                 };%>
                 <th scope="col" class="text-center" style="width:1%;min-width:150px" nowrap><a class="text-reset" href="<%=vm.urls.sort("subcategoryName", vm.query.sortBy === "subcategoryName" ? !vm.query.sortAsc : true)%>">Subcategory&nbsp;<i class="<%=sortClass('subcategoryName')%>" aria-hidden="true"></i></a></th>
                 <th scope="col" class="text-center" nowrap><a class="text-reset" href="<%=vm.urls.sort("title", vm.query.sortBy === "title" ? !vm.query.sortAsc : true)%>">Title&nbsp;<i class="<%=sortClass('title')%>" aria-hidden="true"></i></a></th>
                 <th scope="col" class="text-center" nowrap><a class="text-reset" href="<%=vm.urls.sort("categoryName", vm.query.sortBy === "categoryName" ? !vm.query.sortAsc : true)%>">Category&nbsp;<i class="<%=sortClass('categoryName')%>" aria-hidden="true"></i></a></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <%for (let i = 0; i < vm.results.length; ++i) {
                                                    let pinned = false;
                                                    if (vm.noSearch && vm.results[i].pinnedRecent)
                                                        pinned = true;
                                                    if (!vm.noSearch && vm.results[i].pinnedSearch)
                                                        pinned = true;%>
                                                <tr>
                                                    <td class="text-center text-nowrap px-3"><%=vm.results[i].subcategoryName_%></td>
                                                    <th scope="row" class="text-nowrap font-weight-bold <%-(pinned ? "text-success":"text-primary")%>"><%-(vm.results[i].locked?"<i class='fas fa-lock'></i>&nbsp;":"")%><a class="<%-(pinned ? "text-success":"text-primary")%>" href="/wiki/details.html?id=<%-vm.results[i].id%>"><%=vm.results[i].title%></a><a class="float-right" href="/wiki/details.html?id=<%-vm.results[i].id%>" target="_blank" rel="noopener" aria-label="Open details for <%=vm.results[i].title%> in a new tab"><i class="fas fa-external-link-alt fa-lg" aria-hidden="true"></i></a></th>
                                                    <td class="text-center text-nowrap"><%=vm.results[i].categoryName_%></td>
                                                </tr>
                                                <%}%>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br>
                        <%-include("../shared/pagination", {pageUrl: vm.urls.page, page: vm.page, rows: vm.rows, resultLength: vm.results.length, moreResults: vm.moreResults})-%>
                        <br><br>
                    </div>
                </div>
            </div>
        </div>
        <%-include("../shared/footer")-%>
        <%-include("../shared/scripts")-%>
    </body>
</html>
