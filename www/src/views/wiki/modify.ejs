<!doctype html>
<html lang="en">
    <head>
        <%-include("../shared/meta");-%>
        <%if (vm.wikiPage.id) {%>
        <link href="https://www.legendhub.org/wiki/edit.html?id=<%-vm.wikiPage.id%>" rel="canonical">
        <%}else{%>
        <link href="https://www.legendhub.org/wiki/add.html" rel="canonical">
        <%}%>
        <meta name="robots" content="none">
    </head>
    <body>
        <%-include("../shared/header");-%>
        <div data-react-root="wiki-editor"></div>
        <script type="application/json" data-react-props="wiki-editor"><%-
            serializeJsonForHtml({
                wikiPage: vm.wikiPage,
                categories: vm.categories,
                subcategories: vm.subcategories
            })
        %></script>
        <%-include("../shared/footer");-%>
        <%-include("../shared/scripts");-%>
        <script type="module" src="/build/wiki-editor.js?v=<%-locals.version%>"></script>
    </body>
</html>
