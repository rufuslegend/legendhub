<!doctype html>
<html lang="en">
<head>
    <%-include("../shared/meta")-%>
    <link href="https://www.legendhub.org/builder/index.html" rel="canonical">
    <style>
        .era-abilities-table { table-layout: fixed; }
        @media (prefers-reduced-motion: reduce) { .collapse-caret { transition: none; } }
    </style>
</head>
<body>
    <%-include("../shared/header")-%>
    <div data-react-root="builder"></div>
    <script type="application/json" data-react-props="builder"><%- serializeJsonForHtml({
        itemStatCategories: vm.itemStatCategories,
        selectedColumns: vm.selectedColumns,
        accountContext: {
            authenticated: Boolean(vm.accountContext?.authenticated),
            emailVerified: Boolean(vm.accountContext?.emailVerified),
            canUseAccountStorage: Boolean(vm.accountContext?.canUseAccountStorage),
            storageNamespace: typeof vm.accountContext?.storageNamespace === "string"
                ? vm.accountContext.storageNamespace
                : null
        }
    }) %></script>
    <%-include("../shared/footer")-%>
    <%-include("../shared/scripts")-%>
    <script type="module" src="/build/builder.js?v=<%-locals.version%>"></script>
</body>
</html>
