<!doctype html>
<html lang="en">
<head>
    <%- include('../shared/meta') %>
    <link href="https://www.legendhub.org<%=vm.urls.canonical%>" rel="canonical">
    <meta name="robots" content="noindex">
</head>
<body>
    <%- include('../shared/header') %>
    <div data-react-root="items"></div>
    <script type="application/json" data-react-props="items"><%- serializeJsonForHtml({
        categories: vm.itemStatCategories,
        constants: vm.constants,
        moreResults: vm.moreResults,
        noSearch: vm.noSearch,
        query: vm.query,
        results: vm.results,
        selectedColumns: vm.selectedColumns,
        statInfo: vm.itemStatInfo,
        user: Boolean(locals.user)
    }) %></script>
    <%- include('../shared/footer') %>
    <%- include('../shared/scripts') %>
    <script type="module" src="/build/items.js?v=<%-locals.version%>"></script>
</body>
</html>
