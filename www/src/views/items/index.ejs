<!doctype html>
<html lang="en">
<head>
    <%
    let searchPart = (vm.query.search !== undefined ? '&search=' + vm.query.search : '');
    let filterPart = (vm.query.filters ? '&filters=' + vm.query.filters : '');
    let sortByPart = (vm.query.sortBy ? '&sortBy=' + vm.query.sortBy : '');
    let sortAscPart = (vm.query.sortAsc ? '&sortAsc=' + vm.query.sortAsc : '');
    let pageBaseUrl = '/items/index.html?' + searchPart + filterPart + sortByPart + sortAscPart;
    %>
    <%- include('../shared/meta') %>
    <link href="https://www.legendhub.org<%-pageBaseUrl%>&page=<%-vm.page%>" rel="canonical">
    <meta name="robots" content="noindex">
</head>
<body>
    <%- include('../shared/header') %>
    <div data-react-root="items"></div>
    <script type="application/json" data-react-props="items"><%- JSON.stringify({
        categories: vm.itemStatCategories,
        constants: vm.constants,
        moreResults: vm.moreResults,
        noSearch: vm.noSearch,
        query: vm.query,
        results: vm.results,
        selectedColumns: vm.selectedColumns,
        statInfo: vm.itemStatInfo,
        user: Boolean(locals.user)
    }).replace(/</g, '\\u003c') %></script>
    <%- include('../shared/footer') %>
    <%- include('../shared/scripts') %>
    <script type="module" src="/build/items.js?v=<%-locals.version%>"></script>
</body>
</html>
