<!doctype html>
<html lang="en">
    <head>
        <%- include("../shared/meta"); -%>
        <%if (vm.item.id) {%>
        <link href="https://www.legendhub.org/items/edit.html?id=<%-vm.item.id%>" rel="canonical">
        <%}else{%>
        <link href="https://www.legendhub.org/items/add.html" rel="canonical">
        <%}%>
        <meta name="robots" content="none">
    </head>
    <body>
        <%- include("../shared/header"); -%>
        <div data-react-root="item-editor"></div>
        <script type="application/json" data-react-props="item-editor"><%-
            serializeJsonForHtml({
                constants: vm.constants,
                item: vm.item,
                itemStatCategories: vm.itemStatCategories
            })
        %></script>
        <%- include("../shared/footer"); -%>
        <%- include("../shared/scripts"); -%>
        <script type="module" src="/build/item-editor.js?v=<%-locals.version%>"></script>
    </body>
</html>
