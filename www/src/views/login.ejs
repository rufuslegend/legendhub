<!doctype html>
<html lang="en" style="height: 100%;">
<head>
    <%- include('./shared/meta') %>
    <link href="https://www.legendhub.org/login.html" rel="canonical">
</head>
<body style="height: 100%;">
    <%-include("./shared/header")-%>
	<div class="container">
		<div class="row h-100 align-items-center">
			<div id="accordion" class="col-12 mx-auto" style="max-width: 32.5rem;">
				<form action="/login.html" method="POST" class="card" name="login">
                    <div class="card-header" id="loginHeading">
						<h3 class="text-center mb-0">
                            <button type="button" class="btn btn-link btn-block" data-toggle="collapse" data-target=".multi-collapse" aria-expanded="<%-!vm.register_error%>"
                                aria-controls="loginCollapse registerCollapse">Login</button>
                        </h3>
					</div>
                    <div id="loginCollapse" class="collapse multi-collapse<%-vm.register_error?'':' show'%>" aria-labelledby="loginHeading" data-parent="#accordion">
						<div class="card-body">
							<div class="input-group">
								<div class="input-group-prepend" style="flex: 0 0 10rem; max-width: 10rem;">
									<label class="input-group-text w-100" id="login_usernameLabel" for="login_username">Username or email</label>
								</div>
                                <input id="login_username" name="login_username" type="text" class="form-control" value="<%=vm.body.login_username%>" required autofocus>
							</div>
							<br />
							<div class="input-group">
								<div class="input-group-prepend" style="flex: 0 0 10rem; max-width: 10rem;">
									<label class="input-group-text w-100" id="login_passwordLabel" for="login_password">Password</label>
								</div>
                                <input id="login_password" name="login_password" type="password" class="form-control" required>
							</div>
                            <input name="returnUrl" type="hidden" value="<%=locals.url.query.returnUrl%>" />
                            <% if (vm.login_error) {%>
                            <div class="text-danger"><%=vm.login_error%></div>
                            <%}%>
                            <% if (vm.login_message) {%>
                            <div class="text-success"><%=vm.login_message%></div>
                            <%}%>
							<div class="custom-control custom-checkbox mt-2 mb-3">
								<input id="login_stayLoggedIn" name="login_stayLoggedIn" type="checkbox" class="custom-control-input">
								<label class="custom-control-label clickable" for="login_stayLoggedIn">Stay logged in</label>
							</div>
							<button type="submit" class="btn btn-block btn-primary col">Login</button>
							<a class="btn btn-link btn-block" href="/forgot-password.html">Forgot password?</a>
						</div>
					</div>
				</form>
				<form action="/login.html?returnUrl=<%=locals.url.query.returnUrl%>" method="POST" class="card" name="register">
					<div class="card-header" id="registerHeading">
						<h3 class="text-center mb-0">
                            <button type="button" class="btn btn-link btn-block" data-toggle="collapse" data-target=".multi-collapse"
                                aria-expanded="<%-!!vm.register_error%>" aria-controls="loginCollapse registerCollapse">Register</button>
                        </h3>
					</div>
                    <div id="registerCollapse" class="collapse multi-collapse<%-vm.register_error?' show':''%>" aria-labelledby="registerHeading" data-parent="#accordion">
						<div class="card-body">
							<div class="input-group">
								<div class="input-group-prepend" style="flex: 0 0 10rem; max-width: 10rem;">
									<label class="input-group-text w-100" id="register_usernameLabel" for="register_username">Username</label>
								</div>
                                <input id="register_username" name="register_username" pattern="^[A-Za-z0-9]*$" type="text" class="form-control" value="<%=vm.body.register_username%>" required>
							</div>
							<br />
							<div class="input-group">
								<div class="input-group-prepend" style="flex: 0 0 10rem; max-width: 10rem;">
									<label class="input-group-text w-100" id="register_emailLabel" for="register_email">Email</label>
								</div>
                                <input id="register_email" name="register_email" type="email" autocomplete="email" class="form-control" value="<%=vm.body.register_email%>" required>
							</div>
							<br />
							<div class="input-group">
								<div class="input-group-prepend" style="flex: 0 0 10rem; max-width: 10rem;">
									<label class="input-group-text w-100" id="register_passwordLabel" for="register_password">Password</label>
								</div>
								<input id="register_password" name="register_password" type="password" class="form-control" required>
							</div>
							<br />
							<div class="input-group">
								<div class="input-group-prepend" style="flex: 0 0 10rem; max-width: 10rem;">
									<label class="input-group-text w-100" id="register_confirmPasswordLabel" for="register_confirmPassword">Confirm</label>
								</div>
								<input id="register_confirmPassword" name="register_confirmPassword" type="password" class="form-control" required>
							</div>
                            <!-- TODO replace with ejs errors -->
                            <% if (vm.register_error) {%>
                            <div class="text-danger"><%=vm.register_error%></div>
                            <%}%>
							<br />
                            <div class="form-group g-recaptcha" data-sitekey="<%=process.env.RECAPTCHA_SITEKEY%>"></div>
							<button type="submit" class="btn btn-primary btn-block col">Register</button>
						</div>
					</div>
				</form>
			</div>
		</div>
    <br><br>
	</div>
    <%-include("./shared/footer")-%>
    <%-include("./shared/scripts")-%>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</body>
</html>
