<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

<title><%=title%> | LegendHUB</title>

<meta property="og:site_name" content="LegendHUB" />
<meta property="og:type" content="website" />
<meta property="og:title" content="<%=title%>" />
<meta property="theme-color" content="#343a40" />

<%const accountTheme = locals.accountPreferenceContext?.payload
    ? locals.accountPreferenceContext.payload?.theme
    : null;
const activeTheme = typeof locals.normalizeTheme === "function"
    ? locals.normalizeTheme(accountTheme || (locals.cookies && locals.cookies.theme))
    : "dark";%>
<link id="theme" rel="stylesheet" href="/css/bootstrap-<%=activeTheme%>.min.css?v=<%=locals.version%>">
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.13/css/all.css" integrity="sha384-DNOHZ68U8hZfKXOrtjWvjxusGo9WQnrNx2sqG0tfsghAvtVlRW3tvkXWZh58N9jp" crossorigin="anonymous">
