<header>
<nav class="navbar navbar-expand-md navbar-dark bg-dark">
	<a class="navbar-brand" href="/">LegendHUB</a>
    <%-include("notification", {classes: "btn btn-dark ml-auto mr-3 d-inline-block d-sm-none", id: "not-pop-1"})-%>
	<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
		<span class="navbar-toggler-icon"></span>
	</button>
	<div class="collapse navbar-collapse" id="navbarSupportedContent">
		<ul class="navbar-nav mr-auto">
			<li class="nav-item">
				<a class="nav-link" href="/builder/">Builder</a>
			</li>
			<li class="nav-item">
				<a class="nav-link" href="/items/">Items</a>
			</li>
			<li class="nav-item">
				<a class="nav-link" href="/mobs/">Mobs</a>
			</li>
			<li class="nav-item">
				<a class="nav-link" href="/quests/">Quests</a>
			</li>
			<li class="nav-item">
				<a class="nav-link" href="/wiki/">Wiki</a>
			</li>
			<li class="nav-item">
				<a class="nav-link" href="/manual/">Manual</a>
			</li>
		</ul>
		<ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <%-include("notification", {classes: "btn btn-dark d-none d-sm-inline-block", id: "not-pop-2"})-%>
            </li>
			<li class="nav-item dropdown float-right">
                <button type="button" class="nav-link dropdown-toggle dropdown-toggle-no-caret clickable border-0 bg-transparent" id="themeDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Choose theme">
                    <i class="fas fa-palette"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="themeDropdown">
                    <button type="button" class="dropdown-item d-flex align-items-center" id="glassThemeToggle" aria-expanded="false" aria-controls="glassThemeChoices">
                        <span>Glass</span>
                        <i class="fas ml-auto fa-caret-right theme-menu-caret" aria-hidden="true"></i>
                    </button>
                    <div id="glassThemeChoices" role="group" aria-label="Glass themes" hidden>
                        <%for (const theme of [{name: "Blue", slug: "glass-blue"}, {name: "Emerald", slug: "glass-emerald"}, {name: "Ruby", slug: "glass-ruby"}, {name: "Amethyst", slug: "glass-amethyst"}, {name: "Amber", slug: "glass-amber"}]) {%>
                        <button type="button" class="dropdown-item pl-4" data-theme="<%=theme.slug%>"><%=theme.name%></button>
                        <%}%>
                    </div>
                    <div class="dropdown-divider"></div>
                    <%for (const theme of [{name: "Light", slug: "light"}, {name: "Dark", slug: "dark"}, {name: "Solarized Dark", slug: "solarized-dark"}, {name: "High Contrast", slug: "high-contrast"}]) {%>
                    <button type="button" class="dropdown-item" data-theme="<%=theme.slug%>"><%=theme.name%></button>
                    <%}%>
                </div>
			</li>
			<li class="nav-item">
				<a class="nav-link" href="http://legendmud.org:19999/" target="_blank" rel="noopener noreferrer">Play Now</a>
			</li>
            <%_ if (locals.user) { %>
            <li class="nav-item dropdown float-right">
				<a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><%=locals.user.username%></a>
				<div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    <a class="dropdown-item" href="/account/">Account Settings</a>
					<div class="dropdown-divider"></div>
					<form action="/logout.html" method="post">
						<button type="submit" class="dropdown-item">Logout</button>
					</form>
				</div>
			</li>
            <% } else { %>
			<li class="nav-item">
				<a class="nav-link" href="/login.html?returnUrl=<%-locals.url.path%>">Login</a>
			</li>
            <% } _%>
		</ul>
	</div>
</nav>
<%-include("emailVerificationPrompt")-%>
<%if (locals.breadcrumbs && locals.breadcrumbs.length > 0) {%>
<div class="breadcrumbNav bg-dark">
	<ul class="breadcrumbList text-light">
        <%for (let i = 0; i < locals.breadcrumbs.length; ++i) {%>
		<li class="breadcrumbListLink">
            <%if (locals.breadcrumbs[i].active) {%>
                <span class="active"><%=locals.breadcrumbs[i].display%></span>
            <%}else{%>
                <a href="<%-locals.breadcrumbs[i].href%>"><%=locals.breadcrumbs[i].display%></a>
            <%}%>
		</li>
        <%}%>
	</ul>
</div>
<%}%>
<br/>
</header>
<%-include("notificationWindow")-%>
