<%if(locals.user) {%>
<button id="<%=id%>" class="<%=classes%> clickable" type="button" aria-label="Notifications" data-notification-popover>
    <%if (locals.user.notifications.length > 0) {%>
    <span class="badge badge-pill badge-danger"><%=locals.user.notifications.length%><%=locals.user.moreNotifications?"+":""%></span>&nbsp;
    <%_}_%>
    <i class="fas fa-bell" aria-hidden="true"></i>
</button>
<%}%>
