<% if (locals.user && !locals.user.emailVerified &&
    locals.cookies.emailPromptDismissed !== "true" &&
    !["/account/", "/account/index.html", "/verify-email.html"].includes(locals.url.pathname)) { %>
<div class="modal fade" id="emailVerificationPrompt" tabindex="-1" role="dialog"
    aria-labelledby="email-verification-prompt-heading"
    aria-describedby="email-verification-prompt-description"
    data-email-verification-prompt data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="email-verification-prompt-heading">
                    Verify your email address
                </h2>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="email-verification-prompt-description">
                    Existing LegendHUB features remain available without a verified email.
                    Verification also enables password recovery and account-backed storage.
                </p>
            </div>
            <div class="modal-footer">
                <a class="btn btn-primary" href="/account/#email-heading">
                    Enter and verify your email address now
                </a>
                <form action="/dismiss-email-prompt" method="post" class="mb-0">
                    <input type="hidden" name="returnUrl" value="<%=locals.url.path%>">
                    <button type="submit" class="btn btn-secondary">Dismiss for this login</button>
                </form>
            </div>
        </div>
    </div>
</div>
<% } %>
