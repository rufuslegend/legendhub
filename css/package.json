{
  "name": "legendhub.css",
  "version": "2.1.0",
  "description": "CSS for LegendMUD",
  "scripts": {
    "build": "npm-run-all --parallel build:lint build:compile --sequential build:prefix build:minify build:copy",
    "build:compile": "sass --style expanded --source-map --embed-sources scss:dist/css",
    "build:lint": "stylelint \"scss/**/*.scss\"",
    "build:prefix": "postcss --config build/postcss.config.js --replace \"dist/css/*.css\" \"!dist/css/*.min.css\"",
    "build:minify": "lightningcss --minify --sourcemap --output-file dist/css/bootstrap-light.min.css dist/css/bootstrap-light.css && lightningcss --minify --sourcemap --output-file dist/css/bootstrap-dark.min.css dist/css/bootstrap-dark.css && lightningcss --minify --sourcemap --output-file dist/css/bootstrap-solarized-dark.min.css dist/css/bootstrap-solarized-dark.css && (cd dist/css && lightningcss --minify --sourcemap --output-file bootstrap-glass-blue.min.css bootstrap-glass-blue.css)",
    "build:copy": "shx cp dist/css/*.min.css dist/css/*.min.css.map ../www/src/public/css/",
    "test": "npm run build:lint"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rufuslegend/legendhub.git"
  },
  "keywords": [
    "legendhub",
    "legendmud",
    "hub",
    "mud",
    "css"
  ],
  "author": {
    "name": "Steve Thorne",
    "url": "https://www.sthorne.dev"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rufuslegend/legendhub/issues"
  },
  "homepage": "https://github.com/rufuslegend/legendhub#readme",
  "dependencies": {},
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.2.1",
    "autoprefixer": "^10.5.4",
    "lightningcss-cli": "^1.33.0",
    "npm-run-all2": "^9.0.2",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "sass": "^1.102.0",
    "shx": "^0.4.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0"
  }
}
