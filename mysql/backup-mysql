#!/bin/bash
set -euo pipefail

export MYSQL_PWD="${MYSQL_PASSWORD}"

mkdir -p /backups/private /backups/public

private_backup="/backups/private/database_$(date +%m-%d-%Y).sql.gz"
public_backup="/backups/public/database.sql"

mysqldump \
    -P "${MYSQL_PORT}" \
    -h mysql \
    -u "${MYSQL_USER}" \
    --single-transaction \
    --quick \
    --lock-tables=false \
    --no-tablespaces \
    -B "${MYSQL_DATABASE}" \
    | gzip > "${private_backup}"

mysqldump \
    -P "${MYSQL_PORT}" \
    -h mysql \
    -u "${MYSQL_USER}" \
    --single-transaction \
    --quick \
    --lock-tables=false \
    --no-tablespaces \
    --no-data \
    "${MYSQL_DATABASE}" \
    | sed -e 's/DEFINER[ ]*=[ ]*[^*  ]*\*/\*/' > "${public_backup}"

mysqldump \
    -P "${MYSQL_PORT}" \
    -h mysql \
    -u "${MYSQL_USER}" \
    --single-transaction \
    --quick \
    --lock-tables=false \
    --no-tablespaces \
    --no-create-info \
    --skip-triggers \
    --ignore-table="${MYSQL_DATABASE}.AuthTokens" \
    --ignore-table="${MYSQL_DATABASE}.MemberRoleMap" \
    --ignore-table="${MYSQL_DATABASE}.Members" \
    --ignore-table="${MYSQL_DATABASE}.NotificationChanges" \
    --ignore-table="${MYSQL_DATABASE}.NotificationQueue" \
    --ignore-table="${MYSQL_DATABASE}.NotificationSettings" \
    --ignore-table="${MYSQL_DATABASE}.Notifications" \
    --ignore-table="${MYSQL_DATABASE}.Permissions" \
    --ignore-table="${MYSQL_DATABASE}.PersistentLogins" \
    "${MYSQL_DATABASE}" >> "${public_backup}"

[[ -s "$private_backup" ]] || {
  printf 'backup-mysql: private backup is missing or empty\n' >&2
  exit 1
}

[[ -s "$public_backup" ]] || {
  printf 'backup-mysql: public backup is missing or empty\n' >&2
  exit 1
}

printf 'backup-mysql: success timestamp=%s private=%s private-bytes=%s public=%s public-bytes=%s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  "$private_backup" "$(stat -c %s "$private_backup")" \
  "$public_backup" "$(stat -c %s "$public_backup")"
