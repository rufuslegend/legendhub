COMPOSE_PROJECT_NAME=legendhub-test
NODE_ENV=production
PORT=80
EXTERNAL_PORT=7000
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=<root_password>
MYSQL_USER=legendhub
MYSQL_PASSWORD=<password>
MYSQL_DATABASE=legendhub
CONTENT_SYNC_SOURCE=content-sync@example.invalid
CONTENT_SYNC_SSH_PORT=7822
CONTENT_SYNC_STAGING_DATABASE=legendhub_content_sync
CONTENT_SYNC_INTERVAL_SECONDS=3600
CONTENT_SYNC_MAX_AGE_SECONDS=7200
CONTENT_SYNC_SSH_KEY_FILE=/path/to/content-sync-key
CONTENT_SYNC_KNOWN_HOSTS_FILE=/path/to/content-sync-known-hosts
GITHUB_TOKEN=<fine-grained-token-with-issues-write-permission>
GITHUB_REPOSITORY=rufuslegend/legendhub
RECAPTCHA_SITEKEY=<sitekey>
RECAPTCHA_SECRET=<secret>
